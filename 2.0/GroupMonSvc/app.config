<?xml version="1.0"?>
<configuration>
  <appSettings>
    <add key="MonitoringIntervalMinutes" value="1" />
    <add key="DebugMode" value="False" />
    <add key="AppName" value="Group Monitoring Service" />
    <add key="smtpServer" value="smtphost" />
    <add key="DefaultMailTo" value="groupmonitoring@yourorganisation" />
    <add key="MailFrom" value="groupmonitoring@yourorganisation" />
    <add key="Subject" value="Group Monitoring Alert" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
</configuration>